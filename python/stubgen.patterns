^cvcuda\.Stream\.default$:
    \from typing import ClassVar
    default: ClassVar[Stream]

# These legacy call surfaces place a defaulted positional argument before one
# or more required arguments. The extension accepts that ordering, but Python
# stub syntax does not. Keep the runtime API unchanged and describe the
# trailing required arguments as keyword-only, which is the valid subset used
# by the documented call forms.
^cvcuda\.Label\.__init__$:
    \from typing import overload, SupportsIndex, SupportsInt
    @overload
    def __init__(self, utf8Text: str, fontSize: SupportsInt | SupportsIndex, fontName: str, tlPos: tuple, fontColor: tuple, bgColor: tuple) -> None: ...
    @overload
    def __init__(self, utf8Text: str, fontSize: SupportsInt | SupportsIndex, *, fontName: str = 'DejaVuSansMono', tlPos: tuple, fontColor: tuple, bgColor: tuple) -> None: ...

