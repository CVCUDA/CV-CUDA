# nanobind.stubgen assumes that any class attribute whose value has the same
# type as its owning class is an enum member. Format and TensorLayout are value
# classes with interned class constants, so describe those constants directly.
# enum_compat intentionally exposes pybind11-style enum classes rather than
# enum.Enum subclasses. Describe their protocol and members explicitly because
# nanobind.stubgen otherwise treats the detached wrapper instances as integers.
^cvcuda\.(AdaptiveThresholdType|Border|ChannelManip|ClockFormat|ColorConversion|ColorSpec|ConnectivityType|HistogramEq|Interp|LABEL|LabelMaskType|Matcher|MorphologyType|Norm|NormalizeFlags|Remap|Round|SIFT|ThreadScope|ThresholdType)\.__prefix__$:
    \from typing import Any, ClassVar, SupportsIndex, SupportsInt
    __members__: ClassVar[dict[str, \1]]
    def __init__(self, value: SupportsInt | SupportsIndex) -> None: ...
    def __eq__(self, other: Any) -> bool: ...
    def __ne__(self, other: Any) -> bool: ...
    def __hash__(self) -> int: ...
    def __index__(self) -> int: ...
    def __int__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def value(self) -> int: ...

^cvcuda\.(AdaptiveThresholdType|Border|ChannelManip|ClockFormat|ColorConversion|ColorSpec|ConnectivityType|HistogramEq|Interp|LABEL|LabelMaskType|Matcher|MorphologyType|Norm|NormalizeFlags|Remap|Round|SIFT|ThreadScope|ThresholdType)\.(name|value)$:

