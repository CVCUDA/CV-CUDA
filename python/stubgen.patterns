    \from typing import ClassVar
    \2: ClassVar[\1]
^cvcuda\.Format\.(_?[0-9A-Z][A-Za-z0-9_]*)$:
    \from typing import ClassVar
    \1: ClassVar[Format]

^cvcuda\.Type\.(_[234][0-9A-Z]*)$:
