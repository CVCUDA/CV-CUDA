# versions.env — single source of truth for all Python dependency versions in CV-CUDA.
# Edit this file to update any pinned version, then regenerate requirements files:
#   bash generate_requirements.sh

# CUDA base versions
cuda_cu12=12.5.0
cuda_cu13=13.3.0
cuda_cu13_arm=13.0.1   # arm CI constraint: hosts lack drivers for 13.3

# PyTorch
torch_cu12=2.13.0
torch_cu12_index=cu126   # wheel index for CUDA 12.x (backward compatible with CUDA 12.5+)
torch_cu13=2.13.0
torch_cu13_index=cu130   # wheel index for CUDA 13.x (forward compatible with CUDA 13.3+, cu133 index not available yet)

# torchvision (versions must be paired with torch)
torchvision_cu12=0.28.0
torchvision_cu13=0.28.0

# NumPy
numpy_v1=1.26.4          # Python 3.10-3.12 only (no 3.13+ support for NumPy 1.x)
numpy_v2_py310=2.2.6     # Python 3.10
numpy_v2_py311plus=2.4.4  # Python 3.11+

# CuPy
cupy_cu12=14.0.1          # NumPy 2.x; CuPy 14 requires NumPy 2+
cupy_cu12_numpy1=13.6.0   # Last CuPy 13 release; supports NumPy 1.22-2.5
cupy_cu13=14.0.1          # NumPy 2.x; CuPy 14 requires NumPy 2+

# NVIDIA packages
nvimgcodec=0.7.0.11      # nvidia-nvimgcodec-cu{12,13} — same version for both
nvjpeg_cu12=12.4.0.76    # nvidia-nvjpeg-cu12 (CUDA 12 only)
nvjpeg_cu13=13.0.4.44    # nvidia-nvjpeg (no CUDA suffix) for CUDA 13

tensorrt_cu12=10.13.3.9.post1
tensorrt_cu13=11.1.0.106

cuda_python_cu12=12.9.4
cuda_python_cu13=13.0.3

pynvvideocodec=2.1.0

# Benchmarking dependencies
pycuda=2025.1.2
pandas=2.3.3
cuda_pathfinder=1.3.3
nvtx=0.2.13

# Samples dependencies
onnx=1.22.0
onnxscript=0.6.2
onnxslim=0.1.78

# Build dependencies
pybind11=3.0.3
pybind11_stubgen=2.5.5
setuptools=80.10.2
wheel=0.46.2
build=1.3.0
patchelf=0.17.2.1
auditwheel=6.4.2
flake8=7.1.0

# Tests common dependencies
pytest=9.1.1
typing_extensions=4.13.1

# Docs dependencies
sphinx=8.1.3
exhale=0.3.7
breathe=4.36.0
sphinx_rtd_theme=3.0.2
sphinx_tabs=3.4.7
recommonmark=0.7.1
graphviz=0.20.3
sphinxcontrib_jquery=4.1
sphinxcontrib_jsmath=1.0.1
sphinxcontrib_applehelp=2.0.0
sphinxcontrib_devhelp=2.0.0
sphinxcontrib_htmlhelp=2.1.0
sphinxcontrib_qthelp=2.0.0
sphinxcontrib_serializinghtml=2.0.0
