# Common Python packages for CV-CUDA samples
# Used by both CUDA 12 and CUDA 13 samples

# NumPy 2 with version constraints based on Python version
numpy==${numpy_v2_py310}; python_version=="3.10"
numpy==${numpy_v2_py311plus}; python_version>="3.11"

# Sample dependencies
onnx==${onnx}
onnxscript==${onnxscript}
onnxslim==${onnxslim}

# Interop dependencies
pycuda==${pycuda}
PyNvVideoCodec==${pynvvideocodec}; (platform_machine == "x86_64" or platform_machine == "amd64") and python_version>="3.10" and python_version<="3.12"
